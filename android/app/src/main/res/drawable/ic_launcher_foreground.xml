<?xml version="1.0" encoding="utf-8"?>
<!-- Amped icon: charging ring (yellow -> orange) around a glowing lightning bolt -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- faint ring track -->
    <path android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z"
        android:strokeColor="#26FFFFFF" android:strokeWidth="6.5" android:fillColor="#00000000" />
    <!-- warm glow behind the bolt -->
    <path android:pathData="M54,32a22,22 0,1 1,0 44a22,22 0,1 1,0 -44z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="22"
                android:startColor="#6EFFB74D" android:endColor="#00FFB74D" />
        </aapt:attr>
    </path>
    <!-- charge arc: 280 degrees clockwise from the top -->
    <path android:pathData="M54,28A26,26 0,1 1,28.39 49.49"
        android:strokeWidth="6.5" android:strokeLineCap="round" android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="sweep" android:centerX="54" android:centerY="54">
                <item android:offset="0.0" android:color="#FFFFB735" />
                <item android:offset="0.25" android:color="#FFFC8E24" />
                <item android:offset="0.528" android:color="#FFF4511E" />
                <item android:offset="0.749" android:color="#FFFFD54F" />
                <item android:offset="1.0" android:color="#FFFFB735" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- bright charge tip -->
    <path android:pathData="M28.39,47.89a1.6,1.6 0,1 1,0 3.2a1.6,1.6 0,1 1,0 -3.2z" android:fillColor="#E6FFECB3" />
    <!-- lightning bolt -->
    <path android:pathData="M59,34L45,56.5L52.8,56.5L49,74L63.5,50L55.6,50Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="34" android:endX="54" android:endY="74">
                <item android:offset="0.0" android:color="#FFFFE082" />
                <item android:offset="0.5" android:color="#FFFFA726" />
                <item android:offset="1.0" android:color="#FFF4511E" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- highlight edge -->
    <path android:pathData="M59,34L45,56.5L49.8,56.5Z" android:fillColor="#50FFFFFF" />
</vector>
